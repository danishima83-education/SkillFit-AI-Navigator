# ---------------------------------------------------------------
# YOUR KEYS GO HERE
# On Replit: DON'T use this file. Open Tools > Secrets and add each
#   name below as a Secret instead. Replit adds DATABASE_URL for you
#   when you create a database.
# On your own computer: copy this file to ".env" and fill it in.
# ---------------------------------------------------------------

# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: change the model (check AI Studio for current names)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Postgres connection. Replit sets this automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: force fake AI answers while you build the UI (no key used)
# AI_MODE=mock
